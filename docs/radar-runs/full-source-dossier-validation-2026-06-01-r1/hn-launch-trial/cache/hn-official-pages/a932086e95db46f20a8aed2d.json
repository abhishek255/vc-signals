px}.card{padding:24px}.card p{color:#8b93a7}.result{padding:28px;line-height:1.75}.result h1,.result h2{color:#00e58b}code{background:#151821;padding:2px 6px;border-radius:5px}.footer{text-align:center;color:#8b93a7;padding:42px 0;border-top:1px solid #20232d}@media(max-width:780px){.row,.grid{grid-template-columns:1fr}.stats{gap:18px}}</style></head><body><div class=\"wrap\"><nav class=\"nav\"><div class=\"brand\">RepoSage</div></nav><section class=\"hero\"><div class=\"pill\">Technical diligence \u00b7 Audit + Patch + PR</div><h1><span class=\"grad\">Know the risk</span><br>before you ship, buy, or rewrite.</h1><p>RepoSage turns any GitHub repo into a CTO-ready risk score, migration roadmap, engineering-hour estimate, and remediation PR.</p><div class=\"stats\"><div class=\"stat\"><b>1,247</b><span>repos analyzed</span></div><div class=\"stat\"><b>18,420</b><span>risks found</span></div><div class=\"stat\"><b>7</b><span>automation engines</span></div></div><div class=\"demo\"><div class=\"inner\"><div class=\"row\"><input id=\"repo\" placeholder=\"https://github.com/owner/repo\"><select id=\"target\"><option value=\"business\">Business Risk Report</option><option value=\"security\">Security Audit</option><option value=\"modernize\">Modernization Plan</option></select></div><button id=\"btn\" class=\"btn main\" onclick=\"scan()\">Run technical diligence</button></div></div></section><div id=\"result\" style=\"display:none\"></div><section class=\"section\"><div class=\"grid\"><div class=\"card\"><h3>For CTOs</h3><p>Risk grade, business impact, and engineering-hour estimate.</p></div><div class=\"card\"><h3>For developers</h3><p>Files, fixes, patch, and GitHub PR workflow.</p></div><div class=\"card\"><h3>For buyers</h3><p>Diligence before acquisition, funding, rewrite, or enterprise sale.</p></div></div></section></div><footer class=\"footer\">RepoSage \u00b7 AI technical diligence</footer><script>let lastReportId=null;async function scan(){let r=document.getElementById('repo').value,t=document.getElementById('target').value;if(!r.includes('github.com'))return alert('Paste a GitHub repo URL');let b=document.getElementById('btn'),o=document.getElementById('result');b.disabled=true;b.textContent='Analyzing...';o.style.display='block';o.innerHTML='<div class=\"result\">Running technical diligence...</div>';try{let res=await fetch('/api/scan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({repo:r,target:t})}),d=await res.json();lastReportId=d.report_id;let patch=d.patch_url?'<a class=\"btn main\" href=\"'+d.patch_url+'\">Download diligence patch</a><button class=\"btn secondary\" onclick=\"openPr()\">Open GitHub PR</button>':'';o.innerHTML='<div class=\"result\">'+(d.html||d.report||d.error)+patch+'</div>';}catch(e){o.innerHTML='<div class=\"result\">'+e.message+'</div>';}b.disabled=false;b.textContent='Run technical diligence';}async function openPr(){if(!lastReportId)return alert('Run a scan first');let res=await fetch('/api/open-pr',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({report_id:lastReportId})}),d=await res.json();if(d.pr_url)location.href=d.pr_url;else alert(d.error||'Could not open PR');}</script></body></html>"
